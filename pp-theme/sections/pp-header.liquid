{%- comment -%}
  Cabecera. En escritorio son dos filas (utilidades + logo, y navegación
  centrada); en móvil, una sola fila con menú lateral y una tira de enlaces
  desplazable, que es como resuelve Princess Polly el mismo menú sin espacio.
{%- endcomment -%}

{%- render 'pp-fonts' -%}

{%- liquid
  assign sid = section.id
  comment
    Un ajuste `link_list` entrega el objeto del menú en esta versión de la API y
    el handle en otras. `default` cubre los dos casos: si la búsqueda no resuelve
    se conserva el valor original.
  endcomment
  assign menu = linklists[section.settings.menu] | default: section.settings.menu
-%}

<header class="pph pph--{{ sid }}" data-pph="{{ sid }}">
  <div class="pph__bar">
    <div class="pph__inner">
      <div class="pph__side pph__side--start">
        <button class="pph__burger" type="button" data-pph-open aria-label="Open menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>

        {%- if section.settings.show_currency -%}
          <span class="pph__util pph__util--currency">
            <span class="pph__flag" aria-hidden="true"></span>
            {{ section.settings.currency_label }}
            <svg class="pph__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </span>
        {%- endif -%}

        {%- if section.settings.rewards_label != blank -%}
          <a class="pph__util pph__util--rewards" href="{{ section.settings.rewards_link | default: '#' }}">
            {{ section.settings.rewards_label }}
          </a>
        {%- endif -%}
      </div>

      <a class="pph__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- comment -%}
          `image_url` no sirve un SVG, y el selector de imágenes ni siquiera los
          lista: para un logo vectorial se indica el nombre del archivo subido a
          Configuración › Archivos y se resuelve con `file_url`.
        {%- endcomment -%}
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name | escape }}"
            width="200"
            height="43"
          >
        {%- elsif section.settings.logo_file != blank -%}
          <img
            src="{{ section.settings.logo_file | file_url }}"
            alt="{{ shop.name | escape }}"
            width="200"
            height="43"
          >
        {%- else -%}
          <span class="pph__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="pph__side pph__side--end">
        <a class="pph__icon" href="{{ routes.search_url }}" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
        </a>
        <a class="pph__icon pph__icon--wish" href="{{ section.settings.wishlist_link | default: '#' }}" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5S3.5 14.8 3.5 9.3A4.8 4.8 0 0 1 12 6.4a4.8 4.8 0 0 1 8.5 2.9c0 5.5-8.5 11.2-8.5 11.2z"/></svg>
        </a>
        <a class="pph__icon pph__icon--account" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M4.8 20c1-3.7 3.8-5.6 7.2-5.6s6.2 1.9 7.2 5.6"/></svg>
        </a>
        <a class="pph__icon pph__icon--bag" href="{{ routes.cart_url }}" aria-label="Bag">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7"/></svg>
          <span class="pph__count" data-pph-count>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  {%- if menu.links.size > 0 -%}
    <nav class="pph__nav" aria-label="Main">
      <ul class="pph__nav-list">
        {%- for link in menu.links -%}
          {%- assign is_sale = false -%}
          {%- assign lowered = link.title | downcase -%}
          {%- if lowered contains 'sale' or lowered contains 'oferta' -%}
            {%- assign is_sale = true -%}
          {%- endif -%}
          {%- comment -%}
            Una lista larga en una sola columna se sale de la pantalla por abajo,
            así que a partir del umbral el desplegable pasa a panel de ancho
            completo y reparte los enlaces en columnas.
          {%- endcomment -%}
          {%- assign is_mega = false -%}
          {%- assign mega_threshold = section.settings.mega_threshold | default: 6 -%}
          {%- if link.links.size > mega_threshold -%}
            {%- assign is_mega = true -%}
          {%- endif -%}
          <li class="pph__nav-item{% if link.links.size > 0 %} has-children{% endif %}{% if is_mega %} is-mega{% endif %}">
            <a class="pph__nav-link{% if is_sale %} is-sale{% endif %}" href="{{ link.url }}">
              {{ link.title }}
              {%- if link.links.size > 0 -%}
                <svg class="pph__nav-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              {%- endif -%}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="pph__drop{% if is_mega %} pph__drop--mega{% endif %}">
                <ul class="pph__drop-list">
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}">{{ child.title }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul class="pph__drop-sub">
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="pph__chips">
      <ul>
        {%- for link in menu.links -%}
          {%- assign lowered = link.title | downcase -%}
          <li>
            <a
              href="{{ link.url }}"
              {% if lowered contains 'sale' or lowered contains 'oferta' %}class="is-sale"{% endif %}
            >{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</header>

{%- if menu.links.size > 0 -%}
  <div class="pph-drawer pph-drawer--{{ sid }}" data-pph-drawer="{{ sid }}" hidden>
    <div class="pph-drawer__scrim" data-pph-close></div>
    <div class="pph-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="pph-drawer__head">
        <span>Menu</span>
        <button type="button" data-pph-close aria-label="Close menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <ul class="pph-drawer__list">
        {%- for link in menu.links -%}
          {%- assign lowered = link.title | downcase -%}
          <li>
            <a
              href="{{ link.url }}"
              {% if lowered contains 'sale' or lowered contains 'oferta' %}class="is-sale"{% endif %}
            >{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul>
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

<style>
  .pph--{{ sid }} {
    --pph-fg: {{ section.settings.text_color }};
    --pph-bg: {{ section.settings.bg_color }};
    --pph-line: {{ section.settings.border_color }};
    --pph-sale: {{ section.settings.sale_color }};

    box-sizing: border-box;
    position: {% if section.settings.sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 50;
    background: var(--pph-bg);
    color: var(--pph-fg);
    font-family: 'Archivo', system-ui, -apple-system, sans-serif;
    border-bottom: 1px solid var(--pph-line);
  }
  .pph--{{ sid }} *, .pph--{{ sid }} *::before, .pph--{{ sid }} *::after { box-sizing: border-box; }
  .pph--{{ sid }} ul { list-style: none; margin: 0; padding: 0; }
  .pph--{{ sid }} a { color: inherit; text-decoration: none; }

  .pph--{{ sid }} .pph__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 10px 14px;
  }
  .pph--{{ sid }} .pph__side { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .pph--{{ sid }} .pph__side--end { justify-content: flex-end; }

  .pph--{{ sid }} .pph__burger {
    width: 26px;
    height: 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .pph--{{ sid }} .pph__burger span { display: block; height: 1.5px; background: var(--pph-fg); }

  .pph--{{ sid }} .pph__util {
    display: none;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pph--{{ sid }} .pph__util--rewards { text-decoration: underline; text-underline-offset: 3px; }
  .pph--{{ sid }} .pph__flag {
    width: 16px;
    height: 11px;
    border-radius: 1px;
    /* Bandera de EE. UU. sintética: evita traer un archivo sólo para 16 px. */
    background:
      linear-gradient(#b22234 0 20%, #fff 20% 40%, #b22234 40% 60%, #fff 60% 80%, #b22234 80% 100%);
    box-shadow: inset 7px 6px 0 0 #3c3b6e;
  }
  .pph--{{ sid }} .pph__caret { width: 9px; height: 9px; fill: none; stroke: currentColor; stroke-width: 2.4; }

  .pph--{{ sid }} .pph__logo { display: flex; align-items: center; justify-content: center; }
  .pph--{{ sid }} .pph__logo img {
    display: block;
    width: {{ section.settings.logo_width_mobile }}px;
    height: auto;
  }
  .pph--{{ sid }} .pph__wordmark {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pph--{{ sid }} .pph__icon { position: relative; display: grid; place-items: center; width: 26px; height: 26px; }
  .pph--{{ sid }} .pph__icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--pph-fg);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pph--{{ sid }} .pph__icon--wish, .pph--{{ sid }} .pph__icon--account { display: none; }
  .pph--{{ sid }} .pph__count {
    position: absolute;
    right: -3px;
    bottom: -1px;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--pph-fg);
    color: var(--pph-bg);
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
  }

  /* Navegación de escritorio */
  .pph--{{ sid }} .pph__nav { position: relative; display: none; border-top: 1px solid var(--pph-line); }
  .pph--{{ sid }} .pph__nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 22px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 14px;
  }
  .pph--{{ sid }} .pph__nav-item { position: relative; }
  .pph--{{ sid }} .pph__nav-link {
    display: block;
    padding: 11px 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pph--{{ sid }} .pph__nav-link { display: flex; align-items: center; gap: 4px; }
  .pph--{{ sid }} .pph__nav-item.has-children .pph__nav-caret { display: block; }
  .pph--{{ sid }} .pph__nav-link.is-sale { color: var(--pph-sale); }

  .pph--{{ sid }} .pph__nav-caret { display: none; width: 8px; height: 8px; fill: none; stroke: currentColor; stroke-width: 2.6; }

  .pph--{{ sid }} .pph__drop {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    min-width: 200px;
    padding: 16px 20px;
    background: var(--pph-bg);
    border: 1px solid var(--pph-line);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }
  /* Puente invisible sobre el hueco entre el enlace y el panel: sin él, el
     desplegable se cierra al cruzar ese píxel con el ratón. */
  .pph--{{ sid }} .pph__drop::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -6px;
    height: 6px;
  }
  /* Se abre al pasar el ratón. El `:hover` de CSS ya basta en un navegador de
     escritorio; la clase `is-open` la pone el guion para sostener el panel
     mientras se cruza el hueco y para poder abrirlo con un toque en pantallas
     táctiles, donde `:hover` no existe. */
  .pph--{{ sid }} .pph__nav-item:hover .pph__drop,
  .pph--{{ sid }} .pph__nav-item.is-open .pph__drop,
  .pph--{{ sid }} .pph__nav-item:focus-within .pph__drop { opacity: 1; visibility: visible; }
  .pph--{{ sid }} .pph__nav-item:hover .pph__nav-link,
  .pph--{{ sid }} .pph__nav-item.is-open .pph__nav-link { text-decoration: underline; text-underline-offset: 4px; }

  .pph--{{ sid }} .pph__drop-list { display: flex; flex-direction: column; gap: 2px; }
  .pph--{{ sid }} .pph__drop a {
    display: block;
    padding: 5px 0;
    font-size: 12px;
    white-space: nowrap;
  }
  .pph--{{ sid }} .pph__drop a:hover { text-decoration: underline; }
  .pph--{{ sid }} .pph__drop-sub a { padding: 3px 0; font-size: 11.5px; color: #6a6a6a; }

  /* Panel ancho: el elemento pasa a `position: static` para que el desplegable
     se posicione contra la barra de navegación y no contra el enlace. */
  .pph--{{ sid }} .pph__nav-item.is-mega { position: static; }
  .pph--{{ sid }} .pph__drop--mega {
    left: 0;
    right: 0;
    transform: none;
    padding: 22px 0 26px;
    border-left: 0;
    border-right: 0;
  }
  .pph--{{ sid }} .pph__drop--mega .pph__drop-list {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat({{ section.settings.mega_rows | default: 6 }}, auto);
    justify-content: start;
    gap: 2px 44px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Tira desplazable de móvil */
  .pph--{{ sid }} .pph__chips { border-top: 1px solid var(--pph-line); }
  .pph--{{ sid }} .pph__chips ul {
    display: flex;
    gap: 18px;
    padding: 9px 14px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pph--{{ sid }} .pph__chips ul::-webkit-scrollbar { display: none; }
  .pph--{{ sid }} .pph__chips a {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pph--{{ sid }} .pph__chips a.is-sale { color: var(--pph-sale); }

  @media screen and (min-width: 900px) {
    .pph--{{ sid }} .pph__burger, .pph--{{ sid }} .pph__chips { display: none; }
    .pph--{{ sid }} .pph__util { display: inline-flex; }
    .pph--{{ sid }} .pph__icon--wish, .pph--{{ sid }} .pph__icon--account { display: grid; }
    .pph--{{ sid }} .pph__nav { display: block; }
    .pph--{{ sid }} .pph__inner { padding: 14px 24px; }
    .pph--{{ sid }} .pph__logo img { width: {{ section.settings.logo_width }}px; }
    .pph--{{ sid }} .pph__side { gap: 18px; }
  }

  /* Menú lateral */
  .pph-drawer--{{ sid }} { position: fixed; inset: 0; z-index: 90; font-family: 'Archivo', system-ui, sans-serif; }
  .pph-drawer--{{ sid }}[hidden] { display: none; }
  .pph-drawer--{{ sid }} * { box-sizing: border-box; }
  .pph-drawer--{{ sid }} ul { list-style: none; margin: 0; padding: 0; }
  .pph-drawer--{{ sid }} a { color: {{ section.settings.text_color }}; text-decoration: none; }
  .pph-drawer--{{ sid }} .pph-drawer__scrim { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); }
  .pph-drawer--{{ sid }} .pph-drawer__panel {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(84vw, 340px);
    display: flex;
    flex-direction: column;
    background: {{ section.settings.bg_color }};
    transform: translateX(-100%);
    transition: transform 0.25s ease;
  }
  .pph-drawer--{{ sid }}.is-open .pph-drawer__panel { transform: translateX(0); }
  .pph-drawer--{{ sid }} .pph-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1px solid {{ section.settings.border_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pph-drawer--{{ sid }} .pph-drawer__head button { padding: 0; border: 0; background: none; cursor: pointer; }
  .pph-drawer--{{ sid }} .pph-drawer__head svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: {{ section.settings.text_color }};
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .pph-drawer--{{ sid }} .pph-drawer__list { flex: 1 1 auto; overflow-y: auto; padding: 6px 18px 28px; }
  .pph-drawer--{{ sid }} .pph-drawer__list > li > a {
    display: block;
    padding: 13px 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }
  .pph-drawer--{{ sid }} .pph-drawer__list > li > a.is-sale { color: {{ section.settings.sale_color }}; }
  .pph-drawer--{{ sid }} .pph-drawer__list ul a {
    display: block;
    padding: 8px 0 8px 12px;
    font-size: 12.5px;
    color: #4a4a4a;
  }
  .pph-drawer--{{ sid }} .pph-drawer__list ul { padding: 6px 0 10px; }
</style>

<script>
  (function () {
    var header = document.querySelector('[data-pph="{{ sid }}"]');
    var drawer = document.querySelector('[data-pph-drawer="{{ sid }}"]');
    if (!header || header.dataset.pphReady) return;
    header.dataset.pphReady = '1';

    if (drawer) {
      var open = header.querySelector('[data-pph-open]');

      function setOpen(state) {
        if (state) {
          drawer.hidden = false;
          // Un fotograma antes de la clase, para que la transición del panel
          // arranque desde el estado oculto en vez de saltar a su sitio.
          window.requestAnimationFrame(function () { drawer.classList.add('is-open'); });
        } else {
          drawer.classList.remove('is-open');
          window.setTimeout(function () { drawer.hidden = true; }, 250);
        }
        document.documentElement.style.overflow = state ? 'hidden' : '';
        if (open) open.setAttribute('aria-expanded', state ? 'true' : 'false');
      }

      if (open) open.addEventListener('click', function () { setOpen(true); });
      Array.prototype.forEach.call(drawer.querySelectorAll('[data-pph-close]'), function (el) {
        el.addEventListener('click', function () { setOpen(false); });
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !drawer.hidden) setOpen(false);
      });
    }

    {%- comment -%}
      El desplegable se abre con `:hover` en CSS; esto lo refuerza. Al entrar en
      el elemento se marca `is-open` y al salir se retira con un respiro, de modo
      que un desvío del ratón al bajar hacia el panel no lo cierre de golpe. En
      pantallas táctiles no hay `:hover`: allí el primer toque sobre un enlace
      con hijos abre las subcategorías en vez de navegar, y el segundo ya entra.
    {%- endcomment -%}
    var items = Array.prototype.slice.call(header.querySelectorAll('.pph__nav-item.has-children'));
    var closeTimer = null;
    var coarse = window.matchMedia && window.matchMedia('(hover: none)').matches;

    function closeAll(except) {
      items.forEach(function (item) {
        if (item === except) return;
        item.classList.remove('is-open');
        var trigger = item.querySelector('.pph__nav-link');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
    }

    function openItem(item) {
      window.clearTimeout(closeTimer);
      closeAll(item);
      item.classList.add('is-open');
      var trigger = item.querySelector('.pph__nav-link');
      if (trigger) trigger.setAttribute('aria-expanded', 'true');
    }

    items.forEach(function (item) {
      var trigger = item.querySelector('.pph__nav-link');
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-haspopup', 'true');
      }

      item.addEventListener('mouseenter', function () { openItem(item); });
      item.addEventListener('mouseleave', function () {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(function () { closeAll(null); }, 160);
      });
      item.addEventListener('focusin', function () { openItem(item); });

      if (coarse && trigger) {
        trigger.addEventListener('click', function (event) {
          if (!item.classList.contains('is-open')) {
            event.preventDefault();
            openItem(item);
          }
        });
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeAll(null);
    });
    document.addEventListener('click', function (event) {
      if (!header.contains(event.target)) closeAll(null);
    });

    // El contador del carrito lo pinta Liquid en la primera carga; si el tema
    // expone la API de secciones, se refresca tras añadir sin recargar.
    document.addEventListener('pp:cart-updated', function (event) {
      var badge = header.querySelector('[data-pph-count]');
      if (badge && event.detail && typeof event.detail.item_count === 'number') {
        badge.textContent = event.detail.item_count;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "PP · Cabecera",
  "tag": "section",
  "class": "pp-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_file", "label": "Logo SVG (nombre del archivo)", "info": "Para logos vectoriales: subilo a Configuración › Archivos y escribí aquí su nombre, p. ej. logo.svg. Sólo se usa si el selector de arriba está vacío." },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo · escritorio (px)", "min": 90, "max": 320, "step": 10, "default": 200 },
    { "type": "range", "id": "logo_width_mobile", "label": "Ancho del logo · móvil (px)", "min": 80, "max": 240, "step": 10, "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Fijar al hacer scroll", "default": true },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 1100, "max": 1800, "step": 20, "default": 1600 },
    { "type": "range", "id": "mega_threshold", "label": "Enlaces para pasar a panel ancho", "min": 4, "max": 14, "step": 1, "default": 6 },
    { "type": "range", "id": "mega_rows", "label": "Filas del panel ancho", "min": 3, "max": 10, "step": 1, "default": 6 },
    { "type": "header", "content": "Utilidades" },
    { "type": "checkbox", "id": "show_currency", "label": "Mostrar selector de moneda", "default": true },
    { "type": "text", "id": "currency_label", "label": "Moneda", "default": "USD" },
    { "type": "text", "id": "rewards_label", "label": "Enlace de fidelidad", "default": "Rewards" },
    { "type": "url", "id": "rewards_link", "label": "Destino de fidelidad" },
    { "type": "url", "id": "wishlist_link", "label": "Destino de favoritos" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#000000" },
    { "type": "color", "id": "border_color", "label": "Líneas", "default": "#E5E5E5" },
    { "type": "color", "id": "sale_color", "label": "Rebajas", "default": "#E80404" }
  ],
  "presets": [{ "name": "PP · Cabecera" }]
}
{% endschema %}
