{%- comment -%}
  Rejilla editorial de categorías: cuatro piezas grandes con una pastilla blanca
  abajo a la izquierda. Dos columnas en escritorio y una en móvil, con imagen
  vertical propia para cada bloque cuando la campaña la trae.
{%- endcomment -%}

{%- render 'pp-fonts' -%}

{%- liquid
  assign sid = section.id
-%}

{%- if section.blocks.size > 0 -%}
  <section class="ppcg ppcg--{{ sid }}">
    {%- if section.settings.title != blank -%}
      <h2 class="ppcg__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="ppcg__grid">
      {%- for block in section.blocks -%}
        {%- comment -%}
          El ajuste `collection` entrega el handle en esta versión de la API y
          el objeto en otras: se resuelve contra `collections` y, si no hay
          coincidencia, se conserva el valor original, de modo que la pieza
          funciona en ambos casos.

          La pieza puede apuntar a una colección y quedarse sin más ajustes: el
          rótulo, el destino y la foto salen de ella. Así la rejilla sigue viva
          cuando cambia el surtido, en vez de congelar una imagen de campaña.
          Cualquier valor propio del bloque manda sobre el de la colección.
        {%- endcomment -%}
        {%- liquid
          assign coll = collections[block.settings.collection] | default: block.settings.collection
          assign fallback = blank
          if coll != blank
            assign fallback = coll.image | default: coll.products.first.featured_image
          endif

          assign desktop = block.settings.image | default: fallback
          assign mobile = block.settings.image_mobile | default: desktop
          assign label = block.settings.label
          if label == blank
            assign label = coll.title
          endif
          assign target = block.settings.link
          if target == blank
            assign target = coll.url
          endif
        -%}
        <a class="ppcg__cell" href="{{ target | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if mobile != blank -%}
            <img
              class="ppcg__img ppcg__img--mobile"
              src="{{ mobile | image_url: width: 900 }}"
              alt="{{ label | escape }}"
              width="854"
              height="900"
              loading="lazy"
            >
          {%- endif -%}
          {%- if desktop != blank -%}
            <img
              class="ppcg__img ppcg__img--desktop"
              src="{{ desktop | image_url: width: 1400 }}"
              alt="{{ label | escape }}"
              width="960"
              height="851"
              loading="lazy"
            >
          {%- endif -%}

          {%- if label != blank -%}
            <span class="ppcg__pill">{{ label }} <span aria-hidden="true">&gt;</span></span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<style>
  .ppcg--{{ sid }} {
    box-sizing: border-box;
    width: 100%;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
    font-family: 'Archivo', system-ui, -apple-system, sans-serif;
  }
  .ppcg--{{ sid }} *, .ppcg--{{ sid }} *::before, .ppcg--{{ sid }} *::after { box-sizing: border-box; }

  .ppcg--{{ sid }} .ppcg__title {
    margin: 0 auto 14px;
    max-width: {{ section.settings.max_width }}px;
    padding: 0 14px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }

  .ppcg--{{ sid }} .ppcg__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.gap }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.gap }}px;
  }

  .ppcg--{{ sid }} .ppcg__cell {
    position: relative;
    display: block;
    overflow: hidden;
    background: #f1f1f1;
    text-decoration: none;
  }
  .ppcg--{{ sid }} .ppcg__cell { aspect-ratio: {{ section.settings.ratio_mobile }}; }
  .ppcg--{{ sid }} .ppcg__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.focus }};
  }
  .ppcg--{{ sid }} .ppcg__img--desktop { display: none; }

  .ppcg--{{ sid }} .ppcg__pill {
    position: absolute;
    left: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: calc(100% - 28px);
    padding: 9px 16px;
    border-radius: 999px;
    background: {{ section.settings.pill_bg }};
    color: {{ section.settings.pill_text }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media screen and (min-width: 750px) {
    .ppcg--{{ sid }} .ppcg__grid { grid-template-columns: 1fr 1fr; }
    .ppcg--{{ sid }} .ppcg__cell { aspect-ratio: {{ section.settings.ratio }}; }
    .ppcg--{{ sid }} .ppcg__img--mobile { display: none; }
    .ppcg--{{ sid }} .ppcg__img--desktop { display: block; }
    .ppcg--{{ sid }} .ppcg__title { font-size: 26px; margin-bottom: 18px; }
    .ppcg--{{ sid }} .ppcg__pill { left: 22px; bottom: 22px; padding: 11px 20px; font-size: 12px; }
  }
</style>

{% schema %}
{
  "name": "PP · Rejilla editorial",
  "tag": "section",
  "class": "pp-category-grid",
  "settings": [
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "header", "content": "Diseño" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 1100, "max": 1900, "step": 20, "default": 1700 },
    { "type": "range", "id": "gap", "label": "Separación (px)", "min": 0, "max": 24, "step": 2, "default": 8 },
    { "type": "text", "id": "ratio", "label": "Proporción en escritorio", "info": "Formato ancho/alto, p. ej. 960/851 o 4/5.", "default": "960 / 851" },
    { "type": "text", "id": "ratio_mobile", "label": "Proporción en móvil", "default": "854 / 900" },
    {
      "type": "select",
      "id": "focus",
      "label": "Zona visible al recortar",
      "default": "center top",
      "options": [
        { "value": "center top", "label": "Arriba" },
        { "value": "center center", "label": "Centro" },
        { "value": "center bottom", "label": "Abajo" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 100, "step": 2, "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 100, "step": 2, "default": 34 },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Título", "default": "#000000" },
    { "type": "color", "id": "pill_bg", "label": "Fondo de la pastilla", "default": "#FFFFFF" },
    { "type": "color", "id": "pill_text", "label": "Texto de la pastilla", "default": "#000000" }
  ],
  "blocks": [
    {
      "type": "cell",
      "name": "Pieza",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección", "info": "Con esto basta: el rótulo, el enlace y la foto salen de la colección." },
        { "type": "image_picker", "id": "image", "label": "Imagen de escritorio", "info": "Opcional. Reemplaza a la foto de la colección." },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagen de móvil", "info": "Si se deja vacía se reutiliza la de escritorio." },
        { "type": "text", "id": "label", "label": "Etiqueta", "info": "Vacío = nombre de la colección." },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Vacío = la colección." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Rejilla editorial",
      "blocks": [{ "type": "cell" }, { "type": "cell" }, { "type": "cell" }, { "type": "cell" }]
    }
  ]
}
{% endschema %}
