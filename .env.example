# --- Meta Ads (Marketing API) ---
# Token de System User con permisos ads_management, ads_read, pages_read_engagement, business_management
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=
META_PIXEL_ID=
# Opcional: cuenta de Instagram para que los ads salgan con tu perfil de IG
META_INSTAGRAM_USER_ID=
META_API_VERSION=v25.0

# --- Shopify (Admin API) ---
# App personalizada con scopes read_products, write_products
SHOPIFY_STORE=mi-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Opcional: tu dominio público (si no, se usa onlineStoreUrl de Shopify)
SHOPIFY_PUBLIC_DOMAIN=
