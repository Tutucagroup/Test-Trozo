<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'krika.css' | asset_url | stylesheet_tag }}
    <style>:root{--k-pink:#EB0284;--k-ink:#252628;--k-bg:#fff;--k-line:#E6E6EA;--k-muted:#6E6F73;--k-soft:#F6F6F8;--k-radius:10px;--k-page:1400px;--k-font-body:system-ui,sans-serif;--k-font-heading:system-ui,sans-serif}</style>
  </head>
  <body>
    <main class="k-wrap" style="text-align:center;padding:60px 16px">
      <img src="{{ 'krika-logo-footer.png' | file_url }}" alt="{{ shop.name }}" width="180" style="margin:0 auto 24px">
      {{ content_for_layout }}
    </main>
  </body>
</html>
