{%- paginate blog.articles by 12 -%}
  <div class="k-wrap">
    <div class="k-collection__head"><h1 class="k-collection__title">{{ blog.title }}</h1></div>
    <div class="k-banners k-banners--3" style="padding-bottom:30px">
      {%- for article in blog.articles -%}
        {%- assign a_alt = article.title | escape -%}
        <a class="k-banner" href="{{ article.url }}">
          {%- if article.image -%}
            {{ article.image | image_url: width: 800 | image_tag: width: 800, loading: 'lazy', alt: a_alt }}
          {%- else -%}
            {{ 'blog-apparel-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="k-banner__caption"><h3>{{ article.title }}</h3></div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="k-pagination">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}<span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "tag": "section", "settings": [] }
{% endschema %}
