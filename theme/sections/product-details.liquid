{%- comment -%}
  Bloques de contenido de la ficha, armados con la copia del producto:
  beneficios, "Ideal para", "Tip Krika" y modo de uso.

  "Ideal para" y "Tip Krika" van dentro del mismo bloque que los beneficios
  para que se lean como parte de la descripción y no como una nota suelta.
{%- endcomment -%}
{%- liquid
  assign marca_pros = '<strong>Por qué te va a gustar</strong></p>'
  assign marca_uso = '<strong>Modo de uso</strong></p>'

  if product.description contains marca_pros
    assign pros_html = product.description | split: marca_pros | last | split: '<ul>' | last | split: '</ul>' | first
    assign pros = pros_html | split: '<li>'
  endif

  if product.description contains marca_uso
    assign pasos_html = product.description | split: marca_uso | last | split: '<ol>' | last | split: '</ol>' | first
    assign pasos = pasos_html | split: '<li>'
  endif

  if product.description contains '<strong>Ideal para:</strong>'
    assign ideal = product.description | split: '<strong>Ideal para:</strong>' | last | split: '</p>' | first | strip
  endif

  if product.description contains '<strong>Tip Krika:</strong>'
    assign tip = product.description | split: '<strong>Tip Krika:</strong>' | last | split: '</p>' | first | strip
  endif

  assign hay_pros = false
  if pros.size > 1 and section.settings.show_benefits
    assign hay_pros = true
  endif

  assign hay_notas = false
  if ideal != blank or tip != blank
    assign hay_notas = true
  endif
-%}

{%- if hay_pros or hay_notas -%}
  <section class="k-section k-pdp-block">
    <div class="k-wrap k-pdp-block__inner">
      {%- if hay_pros -%}
        <header class="k-pdp-block__head">
          <h2 class="k-pdp-block__title">{{ section.settings.benefits_title }}</h2>
          {%- if section.settings.benefits_sub != blank -%}
            <p class="k-pdp-block__sub">{{ section.settings.benefits_sub }}</p>
          {%- endif -%}
        </header>
        <div class="k-cards">
          {%- for pro in pros -%}
            {%- assign texto = pro | split: '</li>' | first | strip -%}
            {%- if texto == blank -%}{%- continue -%}{%- endif -%}
            <article class="k-cards__item">
              <span class="k-cards__icon">{% render 'icon', name: 'check' %}</span>
              <p>{{ texto }}</p>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if hay_notas -%}
        <div class="k-notes{% if hay_pros %} k-notes--after{% endif %}">
          {%- if ideal != blank -%}
            <div class="k-note-card">
              <span class="k-note-card__label">Ideal para</span>
              <p>{{ ideal }}</p>
            </div>
          {%- endif -%}
          {%- if tip != blank -%}
            <div class="k-note-card k-note-card--tip">
              <span class="k-note-card__label">Tip Krika</span>
              <p>{{ tip }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- if pasos.size > 1 and section.settings.show_steps -%}
  <section class="k-section k-pdp-block">
    <div class="k-wrap k-pdp-block__inner">
      <header class="k-pdp-block__head">
        <h2 class="k-pdp-block__title">{{ section.settings.steps_title }}</h2>
        {%- if section.settings.steps_sub != blank -%}
          <p class="k-pdp-block__sub">{{ section.settings.steps_sub }}</p>
        {%- endif -%}
      </header>
      <ol class="k-steps">
        {%- for paso in pasos -%}
          {%- assign texto = paso | split: '</li>' | first | strip -%}
          {%- if texto == blank -%}{%- continue -%}{%- endif -%}
          <li class="k-steps__item"><p>{{ texto }}</p></li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.caution != blank -%}
        <p class="k-caution">{{ section.settings.caution }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Detalles del producto",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_benefits", "label": "Mostrar beneficios", "default": true },
    { "type": "text", "id": "benefits_title", "label": "Título de beneficios", "default": "Por qué te va a gustar" },
    { "type": "text", "id": "benefits_sub", "label": "Subtítulo de beneficios" },
    { "type": "header", "content": "Modo de uso" },
    { "type": "checkbox", "id": "show_steps", "label": "Mostrar modo de uso", "default": true },
    { "type": "text", "id": "steps_title", "label": "Título del modo de uso", "default": "Cómo se usa" },
    { "type": "text", "id": "steps_sub", "label": "Subtítulo del modo de uso", "default": "Paso a paso para sacarle el máximo provecho." },
    { "type": "text", "id": "caution", "label": "Nota de precaución", "default": "Producto de uso externo. Si aparece irritación o molestia, suspende el uso y consulta con un profesional." }
  ],
  "presets": [{ "name": "Detalles del producto" }]
}
{% endschema %}
