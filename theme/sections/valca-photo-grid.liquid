{%- render 'valca-fonts' -%}
{%- assign sid = section.id -%}

<section class="vpg vpg--{{ sid }}" aria-label="{{ section.settings.title | default: 'Galería' | escape }}">
  <div class="vpg__container">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <header class="vpg__header">
        {%- if section.settings.title != blank -%}
          <h2 class="vpg__title">
            {{ section.settings.title }}{% if section.settings.title_accent != blank %}
              <span class="vpg__accent">{{ section.settings.title_accent }}</span>
            {% endif %}
          </h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="vpg__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="vpg__grid">
        {%- for block in section.blocks -%}
          {%- capture media -%}
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 700 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w"
                sizes="(min-width: 750px) 33vw, 33vw"
                alt="{{ block.settings.alt | escape }}"
                width="700"
                height="700"
                loading="lazy"
                decoding="async"
              >
            {%- else -%}
              <span class="vpg__placeholder"></span>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <span class="vpg__caption">{{ block.settings.caption }}</span>
            {%- endif -%}
          {%- endcapture -%}

          {%- if block.settings.link != blank -%}
            <a class="vpg__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ media }}</a>
          {%- else -%}
            <div class="vpg__item" {{ block.shopify_attributes }}>{{ media }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="vpg__empty">Agregá imágenes desde la configuración de esta sección.</p>
    {%- endif -%}

    {%- if section.settings.follow_label != blank -%}
      <div class="vpg__follow">
        <a
          class="vpg__follow-btn"
          href="{{ section.settings.follow_link }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ section.settings.follow_label | escape }} {{ section.settings.follow_handle | escape }}"
        >
          <span class="vpg__follow-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <rect x="4.2" y="4.2" width="15.6" height="15.6" rx="4.4" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="2"/>
              <circle cx="16.9" cy="7.2" r="1.1" fill="currentColor"/>
            </svg>
          </span>
          <span class="vpg__follow-text">
            <span class="vpg__follow-soft">{{ section.settings.follow_label }}</span>
            {%- if section.settings.follow_handle != blank -%}
              <span class="vpg__follow-handle">{{ section.settings.follow_handle }}</span>
            {%- endif -%}
          </span>
          <span class="vpg__follow-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" focusable="false">
              <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .vpg--{{ sid }} {
    --vpg-cols: {{ section.settings.columns_mobile }};
    box-sizing: border-box;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    text-align: center;
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .vpg--{{ sid }} *,
  .vpg--{{ sid }} *::before,
  .vpg--{{ sid }} *::after { box-sizing: border-box; }

  .vpg--{{ sid }} .vpg__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .vpg--{{ sid }} .vpg__header { margin-bottom: 24px; }
  .vpg--{{ sid }} .vpg__title {
    margin: 0 0 8px;
    color: {{ section.settings.title_color }};
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }
  .vpg--{{ sid }} .vpg__accent {
    margin-left: 4px;
    color: {{ section.settings.accent_color }};
    {% if section.settings.accent_style == 'italic_serif' %}
      font-family: 'Libre Baskerville', Georgia, serif;
      font-style: italic;
      font-weight: 400;
    {% endif %}
  }
  .vpg--{{ sid }} .vpg__subtitle {
    margin: 0;
    color: {{ section.settings.subtitle_color }};
    font-size: 14px;
    line-height: 1.5;
  }

  .vpg--{{ sid }} .vpg__grid {
    display: grid;
    grid-template-columns: repeat(var(--vpg-cols), minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    max-width: {{ section.settings.grid_max_width }}px;
    margin: 0 auto;
  }

  .vpg--{{ sid }} .vpg__item {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: {{ section.settings.image_radius }}px;
    {% if section.settings.border_width > 0 %}
      border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    {% endif %}
    background: #F1F1EF;
  }
  .vpg--{{ sid }} .vpg__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .vpg--{{ sid }} a.vpg__item:hover img { transform: scale(1.04); }

  .vpg--{{ sid }} .vpg__placeholder { display: block; width: 100%; height: 100%; }

  .vpg--{{ sid }} .vpg__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 8px 10px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 12px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .vpg--{{ sid }} .vpg__item:hover .vpg__caption { opacity: 1; }

  .vpg--{{ sid }} .vpg__empty { margin: 0; color: {{ section.settings.subtitle_color }}; }

  /* ---- Botón de seguimiento con borde degradado y brillo ---- */
  .vpg--{{ sid }} .vpg__follow {
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }
  .vpg--{{ sid }} .vpg__follow-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    max-width: 100%;
    padding: 10px 18px 10px 14px;
    border: 1.5px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient({{ section.settings.follow_bg }}, {{ section.settings.follow_bg }}) padding-box,
      linear-gradient(95deg, {{ section.settings.gradient_1 }} 0%, {{ section.settings.gradient_2 }} 45%, {{ section.settings.gradient_3 }} 100%) border-box;
    box-shadow: 0 6px 18px rgba(131, 58, 180, 0.14), 0 4px 14px rgba(253, 29, 29, 0.08);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .vpg--{{ sid }} .vpg__follow-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(131, 58, 180, 0.18), 0 8px 20px rgba(253, 29, 29, 0.12);
  }
  .vpg--{{ sid }} .vpg__follow-btn::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -45%;
    width: 34%;
    background: linear-gradient(110deg, transparent 0%, rgba(255,255,255,0.25) 25%, rgba(255,255,255,0.85) 50%, rgba(255,255,255,0.25) 75%, transparent 100%);
    transform: skewX(-18deg);
    animation: vpg-shine-{{ sid }} 3.8s ease-in-out infinite;
    pointer-events: none;
  }

  .vpg--{{ sid }} .vpg__follow-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border-radius: 7px;
    background: linear-gradient(135deg, {{ section.settings.gradient_1 }} 0%, {{ section.settings.gradient_2 }} 48%, {{ section.settings.gradient_3 }} 100%);
    color: #FFFFFF;
    box-shadow: 0 3px 9px rgba(253, 29, 29, 0.2);
  }
  .vpg--{{ sid }} .vpg__follow-icon svg { width: 13px; height: 13px; display: block; }

  .vpg--{{ sid }} .vpg__follow-text {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-size: 13px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .vpg--{{ sid }} .vpg__follow-soft { color: {{ section.settings.follow_label_color }}; font-weight: 650; }
  .vpg--{{ sid }} .vpg__follow-handle {
    background: linear-gradient(95deg, {{ section.settings.gradient_2 }} 0%, {{ section.settings.gradient_3 }} 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 800;
  }
  .vpg--{{ sid }} .vpg__follow-arrow {
    display: inline-flex;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    color: {{ section.settings.gradient_2 }};
    transition: transform 0.22s ease;
  }
  .vpg--{{ sid }} .vpg__follow-btn:hover .vpg__follow-arrow { transform: translateX(2px); }

  @keyframes vpg-shine-{{ sid }} {
    0% { left: -45%; }
    52%, 100% { left: 130%; }
  }

  @media screen and (min-width: 750px) {
    .vpg--{{ sid }} { --vpg-cols: {{ section.settings.columns_desktop }}; }
    .vpg--{{ sid }} .vpg__title { font-size: 32px; }
    .vpg--{{ sid }} .vpg__subtitle { font-size: 16px; }
    .vpg--{{ sid }} .vpg__header { margin-bottom: 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vpg--{{ sid }} .vpg__item img,
    .vpg--{{ sid }} .vpg__follow-btn,
    .vpg--{{ sid }} .vpg__follow-arrow { transition: none; }
    .vpg--{{ sid }} .vpg__follow-btn::after { animation: none; }
  }
</style>

{% schema %}
{
  "name": "VALCA · Galería de fotos",
  "tag": "section",
  "class": "valca-photo-grid-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "title", "label": "Título", "default": "Sé parte de" },
    { "type": "text", "id": "title_accent", "label": "Palabra destacada", "default": "Latinologia" },
    {
      "type": "select", "id": "accent_style", "label": "Estilo del destacado", "default": "bold",
      "options": [
        { "value": "bold", "label": "Igual al título" },
        { "value": "italic_serif", "label": "Serif cursiva" }
      ]
    },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Mostrá tu rutina con #MiPielLatina" },
    { "type": "header", "content": "Cuadrícula" },
    { "type": "range", "id": "columns_mobile", "label": "Columnas en móvil", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_desktop", "label": "Columnas en escritorio", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Separación (px)", "min": 0, "max": 24, "step": 1, "default": 6 },
    { "type": "range", "id": "image_radius", "label": "Radio de imagen (px)", "min": 0, "max": 24, "step": 1, "default": 4 },
    { "type": "range", "id": "border_width", "label": "Grosor del borde (px)", "min": 0, "max": 6, "step": 1, "default": 0 },
    { "type": "color", "id": "border_color", "label": "Color del borde", "default": "#DDDDDD" },
    { "type": "range", "id": "grid_max_width", "label": "Ancho máximo de la cuadrícula (px)", "min": 400, "max": 1400, "step": 20, "default": 600 },
    { "type": "header", "content": "Botón de Instagram" },
    { "type": "text", "id": "follow_label", "label": "Texto", "default": "Seguinos en" },
    { "type": "text", "id": "follow_handle", "label": "Usuario", "default": "@latinologia" },
    { "type": "url", "id": "follow_link", "label": "Enlace" },
    { "type": "color", "id": "follow_bg", "label": "Fondo del botón", "default": "#FFFFFF" },
    { "type": "color", "id": "follow_label_color", "label": "Color del texto", "default": "#8A6A7C" },
    { "type": "color", "id": "gradient_1", "label": "Degradado 1", "default": "#833AB4" },
    { "type": "color", "id": "gradient_2", "label": "Degradado 2", "default": "#A61563" },
    { "type": "color", "id": "gradient_3", "label": "Degradado 3", "default": "#E5842C" },
    { "type": "header", "content": "Sección" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FAFAF7" },
    { "type": "color", "id": "title_color", "label": "Título", "default": "#202020" },
    { "type": "color", "id": "accent_color", "label": "Palabra destacada", "default": "#0194A8" },
    { "type": "color", "id": "subtitle_color", "label": "Subtítulo", "default": "#5F5E5A" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 600, "max": 1600, "step": 20, "default": 1200 },
    { "type": "range", "id": "padding_top", "label": "Espaciado superior (px)", "min": 0, "max": 120, "step": 4, "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Espaciado inferior (px)", "min": 0, "max": 120, "step": 4, "default": 28 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" },
        { "type": "text", "id": "caption", "label": "Pie de foto (al pasar el cursor)" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VALCA · Galería de fotos",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
