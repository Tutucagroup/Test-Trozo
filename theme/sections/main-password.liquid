<div class="k-wrap" style="text-align:center;padding:40px 16px 70px">
  <h1 class="k-collection__title">{{ section.settings.heading }}</h1>
  <p style="color:var(--k-muted);margin:12px 0 26px">{{ section.settings.subheading }}</p>

  {%- form 'storefront_password', class: 'k-form' -%}
    {%- if form.errors -%}<p class="k-note k-note--error">Contraseña incorrecta.</p>{%- endif -%}
    <input type="password" name="password" placeholder="Contraseña de la tienda" aria-label="Contraseña">
    <button type="submit" class="k-btn k-btn--primary">Entrar</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contraseña",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Muy pronto" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Estamos preparando algo especial para ti." }
  ]
}
{% endschema %}
