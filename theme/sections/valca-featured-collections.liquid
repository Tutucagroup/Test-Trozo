{%- render 'valca-fonts' -%}

{%- liquid
  assign sid = section.id
  assign cards = section.blocks
-%}

<section class="vfc vfc--{{ sid }}" data-vfc-root aria-label="{{ section.settings.title | default: 'Colecciones destacadas' | escape }}">
  <div class="vfc__container">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <header class="vfc__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vfc__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="vfc__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if cards.size > 0 -%}
      <div class="vfc__viewport" data-vfc-viewport>
        <div class="vfc__grid">
          {%- for block in cards -%}
            {%- liquid
              assign coll = collections[block.settings.collection]
              assign card_title = block.settings.title
              if card_title == blank
                assign card_title = coll.title
              endif
              assign card_url = block.settings.link
              if card_url == blank and coll.url
                assign card_url = coll.url
              endif
              assign card_img = block.settings.image
              if card_img == blank
                assign card_img = coll.image
              endif
              if card_img == blank and coll.products.first
                assign card_img = coll.products.first.featured_image
              endif
            -%}

            <article class="vfc__card" data-vfc-card {{ block.shopify_attributes }}>
              <a class="vfc__card-link" href="{{ card_url | default: routes.all_products_collection_url }}">
                <div class="vfc__card-media">
                  {%- if card_img != blank -%}
                    <img
                      src="{{ card_img | image_url: width: 800 }}"
                      srcset="{{ card_img | image_url: width: 500 }} 500w, {{ card_img | image_url: width: 800 }} 800w, {{ card_img | image_url: width: 1200 }} 1200w"
                      sizes="(min-width: 750px) 33vw, 75vw"
                      alt="{{ card_title | escape }}"
                      width="800"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- else -%}
                    <span class="vfc__card-placeholder">{{ card_title }}</span>
                  {%- endif -%}
                </div>

                <div class="vfc__card-body">
                  {%- if card_title != blank -%}
                    <h3 class="vfc__card-title">{{ card_title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="vfc__card-desc">{{ block.settings.description }}</p>
                  {%- endif -%}
                  {%- if section.settings.cta_label != blank -%}
                    <span class="vfc__card-cta">
                      {{ section.settings.cta_label }}
                      <span class="vfc__arrow" aria-hidden="true">&rarr;</span>
                    </span>
                  {%- endif -%}
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>
      </div>

      {%- if cards.size > 1 -%}
        <div class="vfc__dots" role="tablist" aria-label="Navegar colecciones">
          {%- for block in cards -%}
            <button
              type="button"
              class="vfc__dot{% if forloop.first %} is-active{% endif %}"
              data-vfc-dot="{{ forloop.index0 }}"
              aria-label="Ir a la colección {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="vfc__shop-all">
          <a class="vfc__shop-all-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="vfc__empty">Agregá colecciones desde la configuración de esta sección.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .vfc--{{ sid }} {
    --vfc-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};
    --vfc-gap: {{ section.settings.gap }}px;

    box-sizing: border-box;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .vfc--{{ sid }} *,
  .vfc--{{ sid }} *::before,
  .vfc--{{ sid }} *::after { box-sizing: border-box; }

  .vfc--{{ sid }} .vfc__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .vfc--{{ sid }} .vfc__header { text-align: center; margin-bottom: 28px; }
  .vfc--{{ sid }} .vfc__eyebrow {
    margin: 0 0 12px;
    color: {{ section.settings.eyebrow_color }};
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .vfc--{{ sid }} .vfc__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: 22px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .vfc--{{ sid }} .vfc__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-bottom: 16px;
  }
  .vfc--{{ sid }} .vfc__viewport::-webkit-scrollbar { display: none; }

  .vfc--{{ sid }} .vfc__grid {
    display: flex;
    gap: 12px;
    width: max-content;
    padding-bottom: 4px;
  }

  .vfc--{{ sid }} .vfc__card {
    flex: 0 0 75vw;
    max-width: 280px;
    scroll-snap-align: center;
  }

  .vfc--{{ sid }} .vfc__card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .vfc--{{ sid }} .vfc__card-media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: #F6F6F6;
  }
  .vfc--{{ sid }} .vfc__card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .vfc--{{ sid }} .vfc__card-link:hover .vfc__card-media img { transform: scale(1.03); }

  .vfc--{{ sid }} .vfc__card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 20px;
    color: {{ section.settings.desc_color }};
    font-size: 13px;
    text-align: center;
  }

  .vfc--{{ sid }} .vfc__card-body { padding: 18px 4px 0; }
  .vfc--{{ sid }} .vfc__card-title {
    margin: 0 0 6px;
    color: {{ section.settings.title_color }};
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }
  .vfc--{{ sid }} .vfc__card-desc {
    margin: 0 0 10px;
    color: {{ section.settings.desc_color }};
    font-size: 12px;
    line-height: 1.5;
  }
  .vfc--{{ sid }} .vfc__card-cta {
    display: inline-block;
    color: {{ section.settings.cta_color }};
    font-size: 13px;
    font-weight: 700;
  }
  .vfc--{{ sid }} .vfc__arrow {
    display: inline-block;
    margin-left: 4px;
    transition: transform 0.25s ease;
  }
  .vfc--{{ sid }} .vfc__card-link:hover .vfc__arrow { transform: translateX(4px); }

  .vfc--{{ sid }} .vfc__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin: 4px 0 24px;
  }
  .vfc--{{ sid }} .vfc__dot {
    width: 6px;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: #D3D1C7;
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }
  .vfc--{{ sid }} .vfc__dot.is-active {
    width: 18px;
    background: {{ section.settings.cta_color }};
  }

  .vfc--{{ sid }} .vfc__shop-all { text-align: center; padding-top: 8px; }
  .vfc--{{ sid }} .vfc__shop-all-btn {
    display: inline-block;
    padding: 13px 32px;
    border: 1px solid {{ section.settings.button_border }};
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .vfc--{{ sid }} .vfc__shop-all-btn:hover {
    background: {{ section.settings.button_bg_hover }};
    color: {{ section.settings.button_text_color_hover }};
  }

  .vfc--{{ sid }} .vfc__empty { margin: 0; text-align: center; color: {{ section.settings.desc_color }}; }

  @media screen and (min-width: 750px) {
    .vfc--{{ sid }} .vfc__header { margin-bottom: 40px; }
    .vfc--{{ sid }} .vfc__title { font-size: 32px; }
    .vfc--{{ sid }} .vfc__viewport { overflow: visible; margin-bottom: 40px; }
    .vfc--{{ sid }} .vfc__grid {
      display: grid;
      grid-template-columns: repeat(var(--vfc-cols), minmax(0, 1fr));
      gap: var(--vfc-gap);
      width: auto;
      padding-bottom: 0;
    }
    .vfc--{{ sid }} .vfc__card { flex: initial; max-width: none; }
    .vfc--{{ sid }} .vfc__card-title { font-size: 18px; }
    .vfc--{{ sid }} .vfc__card-desc { font-size: 13px; margin-bottom: 14px; }
    .vfc--{{ sid }} .vfc__dots { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vfc--{{ sid }} .vfc__card-media img,
    .vfc--{{ sid }} .vfc__arrow,
    .vfc--{{ sid }} .vfc__dot { transition: none; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.vfc--{{ sid }}');
    if (!root || root.dataset.vfcInit === '1') return;
    root.dataset.vfcInit = '1';

    var viewport = root.querySelector('[data-vfc-viewport]');
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-vfc-dot]'));
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-vfc-card]'));
    if (!viewport || !dots.length || !cards.length) return;

    function sync() {
      if (window.innerWidth >= 750) return;
      var center = viewport.scrollLeft + viewport.clientWidth / 2;
      var best = 0;
      var bestDist = Infinity;
      cards.forEach(function (card, i) {
        var dist = Math.abs(card.offsetLeft + card.offsetWidth / 2 - center);
        if (dist < bestDist) { bestDist = dist; best = i; }
      });
      dots.forEach(function (dot, i) { dot.classList.toggle('is-active', i === best); });
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        var card = cards[i];
        if (!card) return;
        viewport.scrollTo({
          left: card.offsetLeft - (viewport.clientWidth - card.offsetWidth) / 2,
          behavior: 'smooth'
        });
      });
    });

    var ticking = false;
    viewport.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () { sync(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  })();
</script>

{% schema %}
{
  "name": "VALCA · Colecciones",
  "tag": "section",
  "class": "valca-featured-collections-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestras líneas" },
    { "type": "text", "id": "title", "label": "Título", "default": "Tres líneas, una misma piel cuidada" },
    { "type": "range", "id": "title_weight", "label": "Grosor del título", "min": 400, "max": 800, "step": 100, "default": 500 },
    { "type": "header", "content": "Tarjetas" },
    { "type": "text", "id": "cta_label", "label": "Texto del enlace de cada tarjeta", "default": "Ver línea" },
    { "type": "range", "id": "image_radius", "label": "Radio de la imagen (px)", "min": 0, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "gap", "label": "Separación en escritorio (px)", "min": 8, "max": 48, "step": 2, "default": 20 },
    { "type": "header", "content": "Botón inferior" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver todos los productos" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "color", "id": "button_bg", "label": "Fondo del botón", "default": "#3BAFBF" },
    { "type": "color", "id": "button_text_color", "label": "Texto del botón", "default": "#FFFFFF" },
    { "type": "color", "id": "button_bg_hover", "label": "Fondo del botón (hover)", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text_color_hover", "label": "Texto del botón (hover)", "default": "#3BAFBF" },
    { "type": "color", "id": "button_border", "label": "Borde del botón", "default": "#DDDCDC" },
    { "type": "range", "id": "button_radius", "label": "Radio del botón (px)", "min": 0, "max": 40, "step": 1, "default": 6 },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texto base", "default": "#202020" },
    { "type": "color", "id": "title_color", "label": "Títulos", "default": "#202020" },
    { "type": "color", "id": "eyebrow_color", "label": "Antetítulo", "default": "#888880" },
    { "type": "color", "id": "desc_color", "label": "Descripciones", "default": "#5F5E5A" },
    { "type": "color", "id": "cta_color", "label": "Enlaces y acento", "default": "#0194A8" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "max_width", "label": "Ancho máximo (px)", "min": 900, "max": 1600, "step": 20, "default": 1220 },
    { "type": "range", "id": "padding_top", "label": "Espaciado superior (px)", "min": 0, "max": 120, "step": 4, "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Espaciado inferior (px)", "min": 0, "max": 120, "step": 4, "default": 20 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (opcional)" },
        { "type": "textarea", "id": "description", "label": "Descripción" },
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VALCA · Colecciones",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
