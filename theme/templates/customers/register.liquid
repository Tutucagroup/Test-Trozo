<div class="k-wrap" style="padding:44px 0 70px">
  <h1 class="k-collection__title" style="text-align:center;margin-bottom:22px">Crear cuenta</h1>
  {%- form 'create_customer', class: 'k-form' -%}
    {%- if form.errors -%}<p class="k-note k-note--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div><label for="RegFirst">Nombre</label>
      <input type="text" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
    <div><label for="RegLast">Apellido</label>
      <input type="text" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
    <div><label for="RegEmail">Correo electrónico</label>
      <input type="email" id="RegEmail" name="customer[email]" autocomplete="email" required></div>
    <div><label for="RegPass">Contraseña</label>
      <input type="password" id="RegPass" name="customer[password]" autocomplete="new-password" required></div>
    <button type="submit" class="k-btn k-btn--primary">Registrarme</button>
  {%- endform -%}
</div>
