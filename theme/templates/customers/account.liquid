<div class="k-wrap" style="padding:36px 0 70px">
  <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:22px">
    <h1 class="k-collection__title">Mi cuenta</h1>
    <a class="k-btn k-btn--ghost" href="{{ routes.account_logout_url }}">Cerrar sesión</a>
  </div>

  <h2 style="font-size:18px;margin-bottom:12px">Mis pedidos</h2>
  {%- if customer.orders.size > 0 -%}
    {%- for order in customer.orders -%}
      <div class="k-cart__row" style="grid-template-columns:1fr auto">
        <div>
          <a class="k-cart__name" href="{{ order.customer_url }}">{{ order.name }}</a>
          <div style="color:var(--k-muted);font-size:12.5px">{{ order.created_at | date: '%d/%m/%Y' }} · {{ order.financial_status_label }}</div>
        </div>
        <div style="font-weight:700">{{ order.total_price | money }}</div>
      </div>
    {%- endfor -%}
  {%- else -%}
    <p style="color:var(--k-muted)">Aún no tienes pedidos.</p>
  {%- endif -%}

  <h2 style="font-size:18px;margin:30px 0 12px">Mis direcciones</h2>
  <div style="color:var(--k-muted);font-size:13.5px">{{ customer.default_address | format_address }}</div>
  <a class="k-btn k-btn--ghost" style="margin-top:14px" href="{{ routes.account_addresses_url }}">Administrar direcciones</a>
</div>
