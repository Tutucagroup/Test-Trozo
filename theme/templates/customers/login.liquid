<div class="k-wrap" style="padding:44px 0 70px">
  <h1 class="k-collection__title" style="text-align:center;margin-bottom:22px">Entrar</h1>

  {%- form 'customer_login', class: 'k-form' -%}
    {%- if form.errors -%}<p class="k-note k-note--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div><label for="CustomerEmail">Correo electrónico</label>
      <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required></div>
    <div><label for="CustomerPassword">Contraseña</label>
      <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required></div>
    <button type="submit" class="k-btn k-btn--primary">Entrar</button>
    <a href="#recover" style="font-size:13px;color:var(--k-pink);text-align:center">¿Olvidaste tu contraseña?</a>
  {%- endform -%}

  <p style="text-align:center;margin-top:22px;font-size:13.5px">
    ¿No tienes cuenta? <a href="{{ routes.account_register_url }}" style="color:var(--k-pink);font-weight:600">Crear cuenta</a>
  </p>

  <div id="recover" style="margin-top:44px">
    {%- form 'recover_customer_password', class: 'k-form' -%}
      <h2 style="text-align:center;font-size:18px">Recuperar contraseña</h2>
      {%- if form.posted_successfully? -%}<p class="k-note k-note--success">Te enviamos un correo con las instrucciones.</p>{%- endif -%}
      <input type="email" name="email" placeholder="Correo electrónico" required>
      <button type="submit" class="k-btn k-btn--ghost">Enviar</button>
    {%- endform -%}
  </div>
</div>
