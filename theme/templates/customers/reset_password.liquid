<div class="k-wrap" style="padding:44px 0 70px">
  <h1 class="k-collection__title" style="text-align:center;margin-bottom:22px">Nueva contraseña</h1>
  {%- form 'reset_customer_password', class: 'k-form' -%}
    {%- if form.errors -%}<p class="k-note k-note--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div><label for="ResetPass">Nueva contraseña</label>
      <input type="password" id="ResetPass" name="customer[password]" autocomplete="new-password" required></div>
    <div><label for="ResetPassConf">Confirmar contraseña</label>
      <input type="password" id="ResetPassConf" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="k-btn k-btn--primary">Guardar</button>
  {%- endform -%}
</div>
