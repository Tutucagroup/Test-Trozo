{%- comment -%}
  Filtros (Search & Discovery): marca, precio, disponibilidad, tipo y los que se activen en la app.
  En escritorio es una columna lateral; en celular, un panel que se abre con «Filtrar».
  Parámetros: results (collection o search), clear_url, is_search (bool)
{%- endcomment -%}
{%- liquid
  assign active_count = 0
  for f in results.filters
    if f.type == 'price_range'
      if f.min_value.value != nil or f.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: f.active_values.size
    endif
  endfor
-%}
<aside class="kn-drawer kn-filters kn-filters-drawer" id="KnFilters" aria-label="Filtros">
  <div class="kn-drawer__head">
    <strong>Filtrar{% if active_count > 0 %} ({{ active_count }}){% endif %}</strong>
    <button type="button" class="kn-icon-btn" data-close-panel aria-label="Cerrar filtros"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>
  <form class="kn-drawer__body kn-facets" id="KnFacetsForm" data-facets action="{% if is_search %}{{ routes.search_url }}{% else %}{{ results.url }}{% endif %}" method="get">
    {%- if is_search -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
    {%- elsif results.handle == 'vendors' or results.handle == 'types' -%}
      <input type="hidden" name="q" value="{{ results.title | escape }}">
    {%- endif -%}
    {%- comment -%} Destacados: «Más recientes» ordena por fecha de creación; «Descuentos» muestra los productos de esta colección que también están en la colección Descuentos. {%- endcomment -%}
    {%- unless is_search or results.handle == 'vendors' or results.handle == 'types' -%}
      {%- assign kn_sort = results.sort_by | default: results.default_sort_by -%}
      <details class="kn-facet" open>
        <summary>Destacados<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
        <div class="kn-facet__body">
          <ul class="kn-facet__list" role="list">
            <li><label class="kn-check"><input type="checkbox" data-kn-newest{% if kn_sort == 'created-descending' %} checked{% endif %}><span>Más recientes</span></label></li>
            {%- if results.handle != 'descuentos' and collections['descuentos'].products_count > 0 -%}
              <li><label class="kn-check"><input type="checkbox" data-kn-desc="{{ results.url }}?view=descuentos" data-kn-off="{{ results.url }}"><span>Descuentos</span></label></li>
            {%- endif -%}
          </ul>
        </div>
      </details>
    {%- endunless -%}
    {%- for filter in results.filters -%}
      {%- liquid
        assign label = filter.label
        case filter.param_name
          when 'filter.p.vendor'
            assign label = 'Marca'
          when 'filter.p.product_type'
            assign label = 'Tipo de producto'
          when 'filter.v.availability'
            assign label = 'Disponibilidad'
          when 'filter.v.price'
            assign label = 'Precio'
          when 'filter.p.tag'
            assign label = 'Etiqueta'
        endcase
        assign n_active = filter.active_values.size
        if filter.type == 'price_range'
          assign n_active = 0
          if filter.min_value.value != nil or filter.max_value.value != nil
            assign n_active = 1
          endif
        endif
      -%}
      <details class="kn-facet"{% if forloop.index <= 3 or n_active > 0 %} open{% endif %}>
        <summary>{{ label }}{% if n_active > 0 %}<small>{{ n_active }}</small>{% endif %}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
        <div class="kn-facet__body">
          {%- case filter.type -%}
            {%- when 'price_range' -%}
              {%- liquid
                assign pmin = filter.min_value.value | divided_by: 100
                assign pmax = filter.max_value.value | divided_by: 100
                assign rmax = filter.range_max | divided_by: 100 | plus: 1
              -%}
              <div class="kn-price-range">
                <label>$<input type="number" inputmode="numeric" min="0" max="{{ rmax }}" step="1" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value != nil %}{{ pmin }}{% endif %}" placeholder="Desde" aria-label="Precio desde" data-price></label>
                <span aria-hidden="true">–</span>
                <label>$<input type="number" inputmode="numeric" min="0" max="{{ rmax }}" step="1" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value != nil %}{{ pmax }}{% endif %}" placeholder="Hasta" aria-label="Precio hasta" data-price></label>
              </div>
            {%- else -%}
              {%- if filter.values.size > 8 -%}
                <input type="search" class="kn-facet__find" placeholder="Buscar {{ label | downcase }}…" aria-label="Buscar en {{ label | downcase }}" data-facet-find>
              {%- endif -%}
              <ul class="kn-facet__list" role="list">
                {%- for value in filter.values -%}
                  {%- liquid
                    assign vlabel = value.label
                    if filter.param_name == 'filter.v.availability'
                      if value.value == '1'
                        assign vlabel = 'Con stock'
                      else
                        assign vlabel = 'Sin stock'
                      endif
                    endif
                    if filter.param_name == 'filter.p.vendor'
                      assign words = vlabel | downcase | split: ' '
                      assign vlabel = ''
                      for w in words
                        assign cw = w | capitalize
                        assign vlabel = vlabel | append: ' ' | append: cw
                      endfor
                      assign vlabel = vlabel | strip
                    endif
                    assign disabled = false
                    if value.count == 0 and value.active == false
                      assign disabled = true
                    endif
                  -%}
                  <li data-facet-item="{{ vlabel | downcase | escape }}">
                    <label class="kn-check{% if disabled %} is-disabled{% endif %}">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if disabled %} disabled{% endif %}>
                      <span>{{ vlabel | escape }}</span>
                      <small>({{ value.count }})</small>
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}
    <noscript><button type="submit" class="kn-btn kn-btn--primary kn-btn--full" style="margin-top:14px">Aplicar filtros</button></noscript>
  </form>
  <div class="kn-drawer__foot">
    <a class="kn-btn kn-btn--outline" href="{{ clear_url }}" data-facet-link>Limpiar</a>
    <button type="submit" form="KnFacetsForm" class="kn-btn kn-btn--primary" data-facets-apply>Ver resultados</button>
  </div>
</aside>