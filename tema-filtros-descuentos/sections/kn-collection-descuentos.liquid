{{ 'kn-facets.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Vista «Descuentos» de una colección (/collections/<colección>?view=descuentos).
  Muestra los productos de la colección actual que también están en la colección «Descuentos» (se carga a mano en el admin).
{%- endcomment -%}
{%- liquid
  assign dcoll = collections['descuentos']
  assign base = collection.url
-%}
<div class="kn-wrap">
  <nav class="kn-crumbs" aria-label="Ruta de navegación">
    <a href="{{ routes.root_url }}">Inicio</a> ›
    <a href="{{ base }}">{{ collection.title }}</a> ›
    <span aria-current="page">Descuentos</span>
  </nav>
  <div class="kn-coll__head"><h1>{{ collection.title }} en descuento</h1></div>
  <div class="kn-plp kn-plp--side" data-plp data-section="{{ section.id }}">
    <aside class="kn-drawer kn-filters kn-filters-drawer" id="KnFilters" aria-label="Filtros">
      <div class="kn-drawer__head">
        <strong>Filtrar (1)</strong>
        <button type="button" class="kn-icon-btn" data-close-panel aria-label="Cerrar filtros"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="kn-drawer__body kn-facets">
        <details class="kn-facet" open>
          <summary>Destacados<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
          <div class="kn-facet__body">
            <ul class="kn-facet__list" role="list">
              <li><label class="kn-check"><input type="checkbox" checked data-kn-desc="{{ base }}?view=descuentos" data-kn-off="{{ base }}"><span>Descuentos</span></label></li>
            </ul>
          </div>
        </details>
      </div>
      <div class="kn-drawer__foot">
        <a class="kn-btn kn-btn--outline" href="{{ base }}">Ver todos</a>
        <a class="kn-btn kn-btn--primary" href="{{ dcoll.url }}">Todos los descuentos</a>
      </div>
    </aside>
    <div class="kn-results" data-results>
      {%- paginate dcoll.products by 250 -%}
        {%- capture grid -%}
          {%- assign n = 0 -%}
          {%- for product in dcoll.products -%}
            {%- liquid
              assign inside = false
              if collection.handle == 'all'
                assign inside = true
              else
                for c in product.collections
                  if c.handle == collection.handle
                    assign inside = true
                    break
                  endif
                endfor
              endif
            -%}
            {%- if inside -%}
              {%- assign n = n | plus: 1 -%}
              {% render 'kn-card', product: product, eager: false %}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        <div class="kn-toolbar">
          <div class="kn-toolbar__l">
            <button type="button" class="kn-btn kn-btn--outline kn-filter-btn" data-open-panel="KnFilters"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg> Filtrar</button>
            <span class="kn-count">{{ n }} producto{% if n != 1 %}s{% endif %} en descuento</span>
          </div>
        </div>
        <div class="kn-active"><a href="{{ base }}">Descuentos <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg></a></div>
        {%- if n > 0 -%}
          <div class="kn-grid">{{ grid }}</div>
        {%- else -%}
          <div class="kn-empty">
            <h2>Por ahora no hay descuentos en {{ collection.title }}</h2>
            <p>Mira todos los productos con descuento de la tienda.</p>
            <a class="kn-btn kn-btn--primary" href="{{ dcoll.url }}">Ver descuentos</a>
          </div>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <nav class="kn-pag" aria-label="Paginación">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Página anterior">‹</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Página siguiente">›</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>
<script src="{{ 'kn-facets.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Colección: descuentos",
  "tag": "section",
  "class": "kn-plp-section",
  "settings": []
}
{% endschema %}
